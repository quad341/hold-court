<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hold Court</title>
<link rel="stylesheet" href="/static/style.css">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
</head>
<body>
<header id="app-header">
	<span class="brand">Hold Court</span>
	<span class="tagline">Reads like email. Rules like a bench.</span>
	<span id="live-status" role="status">Connecting to live updates…</span>
	<span id="data-status" role="status" title="Feed data version and when this browser last fetched it">Loading holds…</span>
	<button id="rebuild-cache" type="button" title="Drop this browser's cached holds and re-read the feed directory on the server">Rebuild cache</button>
	<button id="activity-button" type="button">Unread updates (0)</button>
</header>
<form id="search-bar" role="search">
 <label for="search-input">Search (/)</label>
 <input id="search-input" type="search" placeholder="Search holds, #123, pr:123, author:login" aria-describedby="search-summary">
 <label for="search-field">In</label>
 <select id="search-field"><option value="summary">Summary fields</option><option value="author">Author</option><option value="pr">PR number</option></select>
 <button id="clear-search" type="button">Clear</button>
 <span id="search-summary" role="status" aria-live="polite"></span>
</form>
<div id="notice" role="status" hidden></div>
<div id="cache-notice" role="status" hidden><span id="cache-notice-text"></span> <button id="cache-notice-dismiss" type="button">Dismiss</button></div>
<div id="app">
	<nav id="pane-folders">
		<ul>
		{{range .Folders}}
			{{if .Heading}}<li class="folder-heading">{{.Label}}</li>
			{{else}}<li{{if eq .ID $.SelectedFolder}} class="selected"{{end}} data-folder-id="{{.ID}}">{{.Label}} <span class="hold-count">{{.Count}}</span></li>
			{{end}}
		{{end}}
		</ul>
	</nav>
	<div id="folder-divider" role="separator" aria-label="Resize folders" aria-orientation="vertical" tabindex="0"></div>
	<section id="pane-list">
		{{if .HoldCount}}<p class="placeholder">Loading holds…</p>{{else}}<ul></ul>{{end}}
	</section>
	<div id="reading-divider" role="separator" aria-label="Resize hold list" aria-orientation="horizontal" tabindex="0"></div>
	<section id="pane-reading">
		{{if .HoldCount}}<p class="placeholder">Loading holds…</p>{{else}}<p>No holds in this folder.</p>{{end}}
	</section>
</div>
<div id="pending-bar" hidden></div>
<div id="cheatsheet-overlay" hidden>
	<div class="sheet">
		<h2>Keys</h2>
		<table>
		{{range .Keybindings}}
			<tr><td>{{.Key}}</td><td>{{.Action}}</td></tr>
		{{end}}
		</table>
	</div>
</div>
<script id="mode-data" type="application/json">{"record_only":{{.RecordOnly}}}</script>
<div id="consumer-description" hidden>{{.ConsumerDescription}}</div>
<script src="/static/app.js"></script>
<script src="/static/layout.js"></script>
</body>
</html>
